POSTGRES_PASSWORD=replace-with-long-random-password
AUTH_MODE=local
PUBLIC_URL=http://localhost:8080
REGISTRATION_ENABLED=true
SCAN_OSV=true
# Optional token, used only in AUTH_MODE=dev.
DEV_TOKEN=
# Use hybrid for local + SSO, or oidc for SSO only.
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
